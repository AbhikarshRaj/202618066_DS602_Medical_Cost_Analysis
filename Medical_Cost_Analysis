    "from scipy.stats import shapiro, levene, ttest_ind, mannwhitneyu\n",
    "\n",
    "# Separate the two groups\n",
    "smoker_charges = df[df[\"smoker\"] == \"yes\"][\"charges\"]\n",
    "nonsmoker_charges = df[df[\"smoker\"] == \"no\"][\"charges\"]\n",
    "\n",
    "alpha = 0.05\n",
    "\n",
    "\n",
    "# -----------------------------------\n",
    "# 1. Shapiro-Wilk Normality Test\n",
    "# -----------------------------------\n",
    "\n",
    "shapiro_smoker = shapiro(smoker_charges)\n",
    "shapiro_nonsmoker = shapiro(nonsmoker_charges)\n",
    "\n",
    "print(\"SHAPIRO-WILK NORMALITY TEST\")\n",
    "\n",
    "print(\"\\nSmokers\")\n",
    "print(\"Statistic:\", shapiro_smoker.statistic)\n",
    "print(\"p-value:\", shapiro_smoker.pvalue)\n",
    "\n",
    "print(\"\\nNon-Smokers\")\n",
    "print(\"Statistic:\", shapiro_nonsmoker.statistic)\n",
    "print(\"p-value:\", shapiro_nonsmoker.pvalue)\n",
    "\n",
    "\n",
    "# -----------------------------------\n",
    "# 2. Levene's Test\n",
    "# -----------------------------------\n",
    "\n",
    "levene_result = levene(smoker_charges, nonsmoker_charges)\n",
    "\n",
    "print(\"\\nLEVENE'S TEST\")\n",
    "print(\"Statistic:\", levene_result.statistic)\n",
    "print(\"p-value:\", levene_result.pvalue)\n",
    "\n",
    "\n",
    "# -----------------------------------\n",
    "# 3. Choose the correct test\n",
    "# -----------------------------------\n",
    "\n",
    "if shapiro_smoker.pvalue > alpha and shapiro_nonsmoker.pvalue > alpha:\n",
    "\n",
    "    print(\"\\nBoth groups are approximately normal.\")\n",
    "\n",
    "    if levene_result.pvalue > alpha:\n",
    "        equal_var = True\n",
    "        print(\"Equal variance assumption satisfied.\")\n",
    "    else:\n",
    "        equal_var = False\n",
    "        print(\"Equal variance assumption NOT satisfied.\")\n",
    "\n",
    "    result = ttest_ind(\n",
    "        smoker_charges,\n",
    "        nonsmoker_charges,\n",
    "        equal_var=equal_var\n",
    "    )\n",
    "\n",
    "    print(\"\\nT-TEST\")\n",
    "    print(\"Statistic:\", result.statistic)\n",
    "    print(\"p-value:\", result.pvalue)\n",
    "\n",
    "else:\n",
    "\n",
    "    print(\"\\nNormality assumption NOT satisfied.\")\n",
    "    print(\"Using Mann-Whitney U Test.\")\n",
    "\n",
    "    result = mannwhitneyu(\n",
    "        smoker_charges,\n",
    "        nonsmoker_charges,\n",
    "        alternative=\"two-sided\"\n",
    "    )\n",
    "\n",
    "    print(\"\\nMANN-WHITNEY U TEST\")\n",
    "    print(\"Statistic:\", result.statistic)\n",
    "    print(\"p-value:\", result.pvalue)\n",
    "\n",
    "\n",
    "# -----------------------------------\n",
    "# 4. Final Decision\n",
    "# -----------------------------------\n",
    "\n",
