    "import statsmodels.formula.api as smf\n",
    "\n",
    "# Create log-transformed charges\n",
    "df[\"log_charges\"] = np.log(df[\"charges\"])\n",
    "\n",
    "# Fit regression model with BMI × smoker interaction\n",
    "log_model = smf.ols(\n",
    "    formula=\"log_charges ~ age + sex + bmi + children + smoker + region + bmi:smoker\",\n",
    "    data=df\n",
    ").fit()\n",
    "\n",
    "print(log_model.summary())"
